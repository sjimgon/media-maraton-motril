---
const { fecha } = Astro.props;
import Boton from '../components/Botones.astro';
---

<div
  id="cuenta-regresiva"
  class="w-full flex flex-col gap-4 font-semibold text-4xl mt-5 text-center items-center justify-center"
  data-fecha={fecha}
>
  <p
    class="
      text-center
      text-xl md:text-2xl
      font-bold text-secundarioMMM-500
      font-helvetica-ex text-black">
      FALTAN:
  </p>
  
  <div class="w-full max-w-3xl grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 bg-terciarioMMM-900/70 rounded-lg p-4 md:p-6 border-2 border-secundarioMMM-500 place-items-center">
  
  <!-- DÍAS -->
  <div class="flex flex-col items-center text-secundarioMMM-500 font-helvetica">
    <span id="dias" class="text-5xl md:text-5xl font-bold mb-1 tabular-nums">00</span>
    <span class="text-lg md:text-xl font-helvetica-cn tracking-wider uppercase">Días</span>
  </div>

  <!-- HORAS -->
  <div class="flex flex-col items-center text-secundarioMMM-500 font-helvetica">
    <span id="horas" class="text-5xl md:text-5xl font-bold mb-1 tabular-nums">00</span>
    <span class="text-lg md:text-xl font-helvetica-cn tracking-wider uppercase">Horas</span>
  </div>

  <!-- MINUTOS -->
  <div class="flex flex-col items-center text-secundarioMMM-500 font-helvetica">
    <span id="minutos" class="text-5xl md:text-5xl font-bold mb-1 tabular-nums">00</span>
    <span class="text-lg md:text-xl font-helvetica-cn tracking-wider uppercase">Minutos</span>
  </div>

  <!-- SEGUNDOS -->
  <div class="flex flex-col items-center text-secundarioMMM-500 font-helvetica">
    <span id="segundos" class="text-5xl md:text-5xl font-bold mb-1 tabular-nums">00</span>
    <span class="text-lg md:text-xl font-helvetica-cn tracking-wider uppercase">Segundos</span>
  </div>

</div>
</div>

<script>
  // @ts-nocheck
  const el = document.getElementById('cuenta-regresiva');
  const fechaObjetivo = new Date(el.dataset.fecha);
  function actualizarCuentaRegresiva() {
    const ahora = new Date();
    const diferencia = fechaObjetivo - ahora;
    if (diferencia <= 0) {
      el.innerHTML = '¡HA LLEGADO EL MOMENTO!';
      //el.innerHTML = '¡GRACIAS A TODOS POR PARTICIPAR, NOS VEMOS EL AÑO QUE VIENE!';
      clearInterval(intervalo);
      return;
    }
    const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
    const horas = Math.floor((diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
    const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

    el.querySelector('#dias').textContent = dias.toString().padStart(2, '0');
    el.querySelector('#horas').textContent = horas.toString().padStart(2, '0');
    el.querySelector('#minutos').textContent = minutos.toString().padStart(2, '0');
    el.querySelector('#segundos').textContent = segundos.toString().padStart(2, '0');
  }
  actualizarCuentaRegresiva();
  const intervalo = setInterval(actualizarCuentaRegresiva, 1000);
</script>