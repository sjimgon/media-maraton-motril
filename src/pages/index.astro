---
import Layout from '../layouts/LayoutMaster.astro';
import Boton from '../components/Botones.astro';

import CuentaRegresiva from '../components/CuentaRegresiva.astro';
import '../utils/procesarClima.js';
import { CONFIG_METEO } from '../utils/procesarClima.js';
import Icono from '../components/Iconos.astro';
---

<Layout title="Inicio | Media Maratón Ciudad de Motril">

  <main >
    <section 
      id="hero-index"
      class="
        w-full
        min-h-screen
        p-8  md:pt-30
        flex flex-col
        gap-y-4 md:gap-y-2
        items-start justify-center
        bg-[url('/images/index/hero/hero9-bg-web.webp')] bg-center bg-cover bg-no-repeat
        md:bg-[url('/images/index/hero/hero7-bg-web.webp')] md:bg-cover md:bg-center md:bg-no-repeat
      "
    >

      <div
        id="index-container hero"
        class="
          w-full md:w-1/2
          flex flex-col items-center justify-center 
          gap-y-4 md:gap-y-2
        "
      >
        <h1 class="relative flex justify-center">
          <span class="sr-only">
            42 Media Maratón Ciudad de Motril
          </span>

          <img
            src="./svg/index/title.svg"
            alt=""
            aria-hidden="true"
            class="w-120 md:w-180"
          />
        </h1>

         <Boton 
        color="secondary"
        version="positivo"
        href="/inscripciones"
        class="text-3xl md:text-2xl font-bold mt-2 font-helvetica"
      >
        INSCRÍBETE
      </Boton>
            
        <CuentaRegresiva fecha="2026-10-18T10:30:00" /> 

      </div>

    </section>

<!-- SECCIÓN CONDICIONES METEOROLÓGICAS -->
    <section 
      id="meteorologia-index"
      class="
        hidden
        bg-gradient-to-tl from-secundarioMMM-600 to-secundarioMMM-200
        text-terciarioMMM-800
        px-6 py-12 md:py-20
        w-full
        flex flex-col items-center justify-center
      "
    >
      <div
        id="container-meteo-index"
        class="w-full max-w-6xl flex flex-col justify-center items-center"
      >
        <!-- Cabecera homologada con el resto de secciones -->
        <h2 class="text-[1.25rem] font-helvetica font-bold tracking-widest text-terciarioMMM-800 uppercase text-center mb-1">
          PREVISIÓN EN MOTRIL
        </h2>
        <h3 class="text-[5rem] md:text-[6rem] font-bold font-morganite text-terciarioMMM-800 leading-none text-center mb-10 md:mb-14">
          CONDICIONES METEOROLÓGICAS
        </h3>

        <!-- Contenedor de Tarjetas generadas dinámicamente -->
        <div
          id="card-meteorologia"
          class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-center"
        >
          {CONFIG_METEO.dias.map(({ dia, etiqueta, esPrincipal }) => (
            <article
              data-card-dia={dia}
              class={`
                w-full rounded-2xl p-6 md:p-8
                bg-blancoMMM text-terciarioMMM-800
                flex-col items-center justify-between
                transition-all duration-300 ease-in-out hover:-translate-y-1
                ${esPrincipal 
                  ? 'flex md:scale-105 z-10 shadow-2xl border-2 border-terciarioMMM-800' 
                  : 'hidden md:flex opacity-95 shadow-lg border border-secundarioMMM-500/30'}
              `}
            >
              <!-- Etiqueta superior -->
              <span class={`
                text-xs font-helvetica font-bold tracking-widest uppercase px-3 py-1 rounded-full mb-3
                ${esPrincipal 
                  ? 'bg-terciarioMMM-800 text-secundarioMMM-500' 
                  : 'bg-secundarioMMM-200 text-terciarioMMM-800'}
              `}>
                {etiqueta}
              </span>

              <!-- Fecha en fuente Morganite -->
              <h4 class="text-[3.5rem] md:text-[4.25rem] font-morganite font-bold leading-none text-center text-terciarioMMM-800">
                {dia} DE {CONFIG_METEO.nombreMes}
              </h4>

              <!-- Icono y Temperatura principal -->
              <div class="my-5 flex items-center justify-center gap-x-5">
                <img 
                  id={`icono-${dia}`} 
                  alt="Icono meteorológico" 
                  class={esPrincipal ? "w-20 h-20 object-contain" : "w-16 h-16 object-contain"} 
                />
                <span 
                  id={`temperatura-${dia}`} 
                  class="text-[4.5rem] md:text-[5rem] font-morganite font-bold leading-none text-terciarioMMM-600"
                >
                  --°C
                </span>
              </div>

              <!-- Estado del cielo -->
              <p 
                id={`cielo-${dia}`} 
                class="font-helvetica font-bold text-base md:text-lg uppercase tracking-wider text-terciarioMMM-600 mb-5 text-center"
              >
                Cargando...
              </p>

              <!-- Métricas secundarias (Viento y Humedad) -->
              <div class="w-full border-t border-terciarioMMM-800/15 pt-4 grid grid-cols-2 gap-4 text-center font-helvetica">
                <div class="flex flex-col">
                  <span class="text-xs font-bold tracking-widest text-terciarioMMM-500 uppercase">VIENTO</span>
                  <span id={`viento-${dia}`} class="text-lg md:text-xl font-bold text-terciarioMMM-800 mt-0.5">-- km/h</span>
                </div>
                <div class="flex flex-col border-l border-terciarioMMM-800/15">
                  <span class="text-xs font-bold tracking-widest text-terciarioMMM-500 uppercase">HUMEDAD</span>
                  <span id={`humedad-${dia}`} class="text-lg md:text-xl font-bold text-terciarioMMM-800 mt-0.5">-- %</span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <script>
          // @ts-nocheck
          import { procesarClima } from '../utils/procesarClima.js';

          procesarClima()
            .then(resultados => {
              // Si la API ya devuelve datos para los días configurados, mostramos la sección
              if (resultados.length > 0) {
                document.getElementById("meteorologia-index")?.classList.remove("hidden");
              }

              for (const infoDia of resultados) {
                const { dia, cielo, temperatura, viento, humedad, icono } = infoDia;

                const elCielo = document.getElementById(`cielo-${dia}`);
                const elTemp = document.getElementById(`temperatura-${dia}`);
                const elViento = document.getElementById(`viento-${dia}`);
                const elHumedad = document.getElementById(`humedad-${dia}`);
                const elIcono = document.getElementById(`icono-${dia}`);

                if (elCielo) elCielo.textContent = cielo;
                if (elTemp) elTemp.textContent = `${temperatura}°C`;
                if (elViento) elViento.textContent = `${viento} km/h`;
                if (elHumedad) elHumedad.textContent = `${humedad}%`;
                if (elIcono) elIcono.src = icono;
              }
            })
            .catch(error => {
              console.error("Error en la visualización del clima:", error);
            });
        </script>
      </div>
    </section>
<section
