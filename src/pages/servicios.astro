---
// filepath: /src/pages/servicios.astro
import Layout from '../layouts/LayoutMaster.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Iconos.astro';
import LogoSlider from '../components/LogoSlider.astro';

const servicios = [
  {
    title: "Guardarropa",
    desc: "Ubicado en el salón social del recinto portuario. Abierto de 8:00 a 14:00 h.",
    icon: "guardarropa",
  },
  {
    title: "Zona de Calentamiento",
    desc: "Tráfico cerrado 2h antes en Avda. Norman Betune. Avituallamiento disponible.",
    icon: "calentamiento",
  },
  {
    title: "Puntos de Control",
    desc: "Pasos obligatorios durante el recorrido para garantizar la seguridad de la prueba.",
    icon: "checkpoint",
  },
  {
    title: "Duchas",
    desc: "Disponibles en las instalaciones del Real Club Náutico (Recinto Portuario).",
    icon: "ducha",
  },
  {
    title: "Avituallamientos",
    desc: "Cada 2,5 km en carrera y avituallamiento final completo en meta con sólido y líquido.",
    icon: "agua",
  },
  {
    title: "Medalla Finisher",
    desc: "Medalla exclusiva para cada atleta que cruce la línea de meta.",
    icon: "medalla",
  },
  {
    title: "Masajes",
    desc: "Servicio de fisioterapia y masajes gratuito en la zona de recuperación.",
    icon: "masaje",
  },
  {
    title: "Retransmisión en streaming",
    desc: "Sigue la prueba en directo a través de la emisión de Onda Sur Motril.",
    icon: "radio",
  },
];
---

<Layout title="Servicios al corredor | Media Maratón Ciudad de Motril">
   <main class="bg-[url('/images/index/hero/hero10-bg-web.webp')] bg-cover bg-center bg-no-repeat ">
    <div
  class="
    w-full
    flex flex-col items-center justify-center
    pt-20 pb-6 md:pt-40 md:pb-2
    px-4
  "
>
  <div
    class="
      px-8 py-3 md:px-14 md:py-5
      bg-secundarioMMM-500
      rounded-2xl
      shadow-2xl
      flex items-center justify-center
    "
  >
    <h1 
      class="
        text-terciarioMMM-700 
        font-morganite text-9xl md:leading-none font-extrabold
        text-center 
      "
    >
      SERVICIOS AL CORREDOR
    </h1>
  </div>
</div>
    <section id="servicios" class="w-full max-w-7xl mx-auto px-6 py-12 md:py-20">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {servicios.map((servicio) => (
      <div 
        class="
          group relative flex flex-col justify-between p-6
          items-center md:items-start
          text-center md:text-left
          bg-secundarioMMM-100/20 backdrop-blur-md
          border border-secundarioMMM-500/30 rounded-2xl
          hover:border-terciarioMMM-800/80 hover:bg-secundarioMMM-600
          transition-all duration-300 ease-out
          hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-terciarioMMM-800/10
        "
      >
        <!-- Icono (Centrado en < md, alineado a la izquierda en >= md) -->
        <div class="flex items-center justify-center md:justify-start w-full mb-6">
          <div 
            class="
              w-18 h-18 rounded-xl 
              bg-terciarioMMM-800 group-hover:bg-terciarioMMM-800
              flex items-center justify-center 
              transition-colors duration-300
            "
          >
            <Icon name={servicio.icon} class="w-10 h-10 text-blancoMMM group-hover:text-secundarioMMM-500 transition-colors duration-300" />
          </div>
        </div>

        <!-- Texto (Centrado en < md, alineado a la izquierda en >= md) -->
        <div class="flex flex-col flex-grow justify-start items-center md:items-start w-full">
          <h3 
            class="
              font-helvetica font-bold text-2xl 
              text-blancoMMM group-hover:text-terciarioMMM-800 
              tracking-wide mb-2 transition-colors duration-300
            "
          >
            {servicio.title}
          </h3>
          <p class="text-base text-blancoMMM leading-relaxed font-light group-hover:text-terciarioMMM-800 transition-colors duration-300">
            {servicio.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
    <LogoSlider />
  </main>
</Layout>