---
import Layout from "../layouts/LayoutMaster.astro";
---

<Layout title="Voluntariado | Media Maratón Ciudad de Motril">
  <main class="min-h-screen flex flex-col bg-[url('/images/index/hero/hero10-bg-web.webp')] bg-cover bg-center bg-no-repeat">
    <div
      class="
        w-full
        flex flex-col items-center justify-center
        pt-20 pb-6 md:pt-40 md:pb-2
        px-4
      "
    >
      <div
        class="
          px-8 py-3 md:px-14 md:py-5
          bg-secundarioMMM-500
          rounded-2xl
          shadow-2xl
          flex items-center justify-center
        "
      >
        <h1 
          class="
            text-terciarioMMM-700 
            font-morganite text-9xl md:leading-none font-extrabold
            text-center 
          "
        >
          VOLUNTARIOS
        </h1>
      </div>
    </div>

    <section class="flex-1 flex flex-col justify-center items-center px-4 py-12">
      <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSeCqqVIyTFfSh7XDFp6O2wxEcAXdYuYxSTjenTdxEleh6U3xQ/viewform" width="100%" height="1900" frameborder="0" marginheight="0" marginwidth="0">Cargando…</iframe>
      <!-- <div class="w-full max-w-3xl flex flex-col gap-6">
        <p class="text-terciarioMMM-600 font-medium text-xl sm:text-4xl text-center">
          Hemos completado el cupo de voluntarios para la 41 Media Maratón Ciudad de Motril
        </p>
        <p class="text-terciarioMMM-700 font-black text-4xl sm:text-6xl text-center">
          ¡GRACIAS A TODOS!
        </p>
      </div> -->
    </section>
  </main>
</Layout>