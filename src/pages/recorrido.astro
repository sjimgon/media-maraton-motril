---
import Layout from '../layouts/LayoutMaster.astro';
import Icon from '../components/Iconos.astro';
import Boton from '../components/Botones.astro';
import LogoSlider from '../components/LogoSlider.astro';
---

<Layout title="Recorrido | Media Maratón Ciudad de Motril">

  <main class="bg-[url('/images/index/hero/hero10-bg-web.webp')] bg-cover bg-center bg-no-repeat ">
    <div
  class="
    w-full
    flex flex-col items-center justify-center
    pt-20 pb-6 md:pt-40 md:pb-2
    px-4
  "
>
  <div
    class="
      px-8 py-3 md:px-14 md:py-5
      bg-secundarioMMM-500
      rounded-2xl
      shadow-2xl
      flex items-center justify-center
    "
  >
    <h1 
      class="
        text-terciarioMMM-700 
        font-morganite text-9xl md:leading-none font-extrabold
        text-center 
      "
    >
      RECORRIDOS
    </h1>
  </div>
</div>

      <!-- SECCIÓN CIRCUITO 21K -->
<section
  id="circuito-21k"
  class="px-8 pb-8 md:px-12 md:pb-8 flex flex-col items-center justify-center"
>
  <div
    id="bloque-circuito-21k"
    class="w-full flex flex-col justify-center items-center mt-6 md:mt-8"
  >
    <!-- CONTENEDOR ENVOLVENTE -->
    <div class="w-full md:w-3/4 lg:w-1/2 flex flex-col items-center">
      <h2
        class="
          font-helvetica font-bold
          tracking-widest
          text-secundarioMMM-400
          drop-shadow-[0_1px_14px_rgba(0,0,0,0.2)]
          text-4xl
        "
      >
        CIRCUITO 21K
      </h2>

      <img
        src="images/pages/recorrido/21k.webp"
        alt="Recorrido 21K"
        class="
          mt-4 mb-8
          w-full
          shadow-lg
          transition-transform duration-800 transform hover:scale-105
        "
      />
    </div>

    <!-- Botones centrados -->
    <div
      id="botones-recorrido-21k"
      class="flex flex-row gap-4 justify-center items-center"
    >
      <Boton 
        color="primary" 
        version="negativo"
        href="/images/pages/recorrido/21k-hq.webp"
        download="recorrido-21k.webp"
        class="flex items-center gap-2 font-helvetica font-medium text-lg md:text-base"
      >
        DESCARGAR IMAGEN
        <Icon name="arrow-down" class="inline-block w-4 md:w-3 h-5" />
      </Boton>
      <Boton 
        color="" 
        version=""
        target="_blank"
        href="https://www.wikiloc.com/running-trails/mmm26-275090229?wa=sc"
        class="bg-blancoMMM text-green-600 hover:bg-green-600 hover:text-blancoMMM font-helvetica font-medium text-lg md:text-base"
      >
        VER EN WIKILOC
        <Icon name="wikiloc" class="inline-block w-4 md:w-4 h-5 ml-1 pb-1" />
      </Boton>
    </div>

  </div>
</section>

<!-- SECCIÓN CIRCUITO 10K (HOMOLOGADA) -->
<section
  id="circuito-10k"
  class="px-8 pb-8 md:px-12 md:pb-8 flex flex-col items-center justify-center"
>
  <div
    id="bloque-circuito-10k"
    class="w-full flex flex-col justify-center items-center mt-6 md:mt-8"
  >
    <!-- CONTENEDOR ENVOLVENTE -->
    <div class="w-full md:w-3/4 lg:w-1/2 flex flex-col items-center">
      <h2
        class="
          font-helvetica font-bold
          tracking-widest
          text-secundarioMMM-500
          drop-shadow-[0_1px_14px_rgba(0,0,0,0.2)]
          text-4xl
        "
      >
        CIRCUITO 10K
      </h2>

      <img
        src="images/pages/recorrido/10k.webp"
        alt="Recorrido 10K"
        class="
          mt-4 mb-8
          w-full
          shadow-lg
          transition-transform duration-800 transform hover:scale-105
        "
      />
    </div>

    <!-- Botones centrados -->
    <div
      id="botones-recorrido-10k"
      class="flex flex-row gap-4 justify-center items-center"
    >
      <Boton 
        color="primary" 
        version="negativo"
        href="/images/pages/recorrido/10k-hq.webp"
        download="recorrido-10k.webp"
        class="flex items-center gap-2 font-helvetica font-medium text-lg md:text-base"
      >
        DESCARGAR IMAGEN
        <Icon name="arrow-down" class="inline-block w-4 md:w-3 h-5" />
      </Boton>
      <Boton 
        color="" 
        version=""
        target="_blank"
        href="https://www.wikiloc.com/running-trails/mmm26-10k-275236005?wa=sc"
        class="bg-blancoMMM text-green-600 hover:bg-green-600 hover:text-blancoMMM font-helvetica font-medium text-lg md:text-base"
      >
        VER EN WIKILOC
        <Icon name="wikiloc" class="inline-block w-4 md:w-4 h-5 ml-1 pb-1" />
      </Boton>
    </div>

  </div>
</section>
    <LogoSlider />
  </main>
</Layout>
