---
const { title = "42 Media Maratón Ciudad de Motril" } = Astro.props;
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Obtenemos la URL canónica dinámica según la página
const canonicalURL = new URL(Astro.url.pathname, "https://mediamaraton.motril.es").href;
---

<!doctype html>
<html lang="es">
    <head>
        <title>{title}</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <!-- Meta SEO Básicos -->
        <meta name="description" content="Competición deportiva celebrada en la ciudad de Motril con dos pruebas principales, 10 kilómetros y 21 kilómetros" />
        <meta name="keywords" content="Maratón, Motril, Media Maratón, 10K, 21K, Carrera, Deporte" />
        <meta name="author" content="42 Media Maratón Ciudad de Motril" />
        <link rel="canonical" href={canonicalURL} />
        <meta name="theme-color" content="#1e40af" />

        <!-- Favicons (Soporte Google e iOS) -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

        <!-- Open Graph / WhatsApp / Facebook / LinkedIn -->
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content="Competición deportiva celebrada en la ciudad de Motril con dos pruebas principales, 10 kilómetros y 21 kilómetros" />
        <meta property="og:image" content="https://mediamaraton.motril.es/images/otros/OpenGraph%20-%20MMM26%27.webp" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="42 Media Maratón Ciudad de Motril" />
        <meta property="og:site_name" content="42 Media Maratón Ciudad de Motril" />
        <meta property="og:logo" content="https://mediamaraton.motril.es/svg/marca/mmm-blue.svg" />
        <meta property="og:locale" content="es_ES" />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content="Competición deportiva celebrada en la ciudad de Motril con dos pruebas principales, 10 kilómetros y 21 kilómetros" />
        <meta name="twitter:image" content="https://mediamaraton.motril.es/images/otros/OpenGraph%20-%20MMM26%27.webp" />
        <meta name="twitter:image:alt" content="42 Media Maratón Ciudad de Motril" />

        <!-- Datos Estructurados JSON-LD -->
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "SportsEvent",
            "name": "42 Media Maratón Ciudad de Motril",
            "description": "Competición deportiva celebrada en la ciudad de Motril con dos pruebas principales, 10 kilómetros y 21 kilómetros",
            "url": "https://mediamaraton.motril.es",
            "sport": "Atletismo",
            "location": {
              "@type": "Place",
              "name": "Motril",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Motril",
                "addressRegion": "Granada",
                "addressCountry": "ES"
              }
            }
          }
        </script>
    </head>
    <body>
        <Header />
            <slot />
        <Footer />
    </body>
</html>

